# Copy to .env.local
# Server-side URL of the .NET API (Next proxies /backend/* and /uploads/* to it)
API_URL=http://localhost:5080
# Origin allowed to serve map tile images (the ONLY remote origin the storefront may load anything from).
# Default: the public OpenStreetMap tile server. Point it at your own tile server for a fully local setup
# (and change "Map tile URL" in the admin settings to match); leave empty to allow no remote images at all.
MAP_TILE_ORIGIN=https://tile.openstreetmap.org
# Public URL of this storefront (used for metadata/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
