# Copy to .env.prod and fill in. NEVER commit .env.prod.
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod

# ---- Database ----
POSTGRES_DB=onshop
POSTGRES_USER=onshop
# Use a long random value: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# ---- API secrets ----
# Must be at least 32 characters: openssl rand -base64 48
JWT_KEY=change-me-to-a-random-string-of-at-least-32-characters

# The first admin account, created on the first start. Change the password after logging in.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ---- Public addresses ----
# The origins users open in a browser, no trailing slash. HTTPS is required for PWA install
# and for the payment gateway callback. Both hostnames must point at this server and be
# covered by the certificate in deploy/certs/.
PUBLIC_BASE_URL=https://shop.example.com
ADMIN_BASE_URL=https://admin.example.com

# ---- Payments ----
# "Zarinpal" in production. "Fake" is refused when ASPNETCORE_ENVIRONMENT=Production.
PAYMENT_GATEWAY=Zarinpal
ZARINPAL_MERCHANT_ID=
# true while testing against the Zarinpal sandbox
ZARINPAL_SANDBOX=false

# ---- Map tiles ----
# The only remote origin the storefront may load images from.
MAP_TILE_ORIGIN=https://tile.openstreetmap.org

# ---- Kyan accounting sync (optional) ----
KYAN_BASE_URL=
KYAN_API_KEY=
