# Copy to .env.prod and fill in. NEVER commit .env.prod.
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#
# Generate the secret values with:  openssl rand -base64 32

# ---- Database ----
POSTGRES_DB=onshop
POSTGRES_USER=onshop
# Long random value. It is never exposed outside Docker.
POSTGRES_PASSWORD=change-me

# ---- API secrets ----
# MUST be at least 32 characters, or the API refuses to start.
JWT_KEY=change-me-to-a-random-string-of-at-least-32-characters

# The first admin account, created on the very first start.
# Change this password from the admin panel after logging in.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ps-mart.ir
ADMIN_PASSWORD=change-me-strong-password

# Demo catalog, home page content and stories for showing the site before real data exists.
# Fills EMPTY tables only, so it never overwrites real products. Set to false once done.
SEED_SAMPLE_DATA=false

# ---- Public addresses ----
# The origins users open in a browser, no trailing slash.
PUBLIC_BASE_URL=https://ps-mart.ir
ADMIN_BASE_URL=https://admin.ps-mart.ir

# ---- Payments ----
# PAYMENT_GATEWAY = Offline | Zarinpal | Zibal | BehpardakhtMellat
#   Offline            cash on delivery; orders stay Pending until an admin marks them Paid.
#   Zarinpal           needs ZARINPAL_MERCHANT_ID (36 characters).
#   Zibal              needs ZIBAL_MERCHANT ("zibal" is Zibal's public test merchant).
#   BehpardakhtMellat  needs all three MELLAT_* values below.
# Only fill in the block for the gateway you choose; the others stay empty.
PAYMENT_GATEWAY=Offline

# Zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# Zibal
ZIBAL_MERCHANT=

# Behpardakht Mellat (درگاه به‌پرداخت ملت). These are the credentials the bank's
# support gives you for the terminal — not your internet-banking login.
MELLAT_TERMINAL_ID=
MELLAT_USER_NAME=
MELLAT_USER_PASSWORD=

# ---- Map tiles ----
# The only remote origin the storefront may load images from.
MAP_TILE_ORIGIN=https://tile.openstreetmap.org

# ---- Kyan accounting sync (optional) ----
KYAN_BASE_URL=
KYAN_API_KEY=
